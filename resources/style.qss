QWidget { font-size: 13px; }
QMainWindow, QDialog { background: #f5f6fa; }
QListWidget { background: #2c3e50; color: #ecf0f1; border: none; font-size: 14px; outline: none; }
QListWidget::item { height: 40px; padding-left: 16px; }
QListWidget::item:selected { background: #3498db; color: white; }
QListWidget::item:hover { background: #34495e; }
QPushButton { background: #3498db; color: white; border: none; border-radius: 4px; padding: 6px 16px; }
QPushButton:hover { background: #2980b9; }
QPushButton:disabled { background: #bdc3c7; }
QLineEdit, QComboBox, QSpinBox, QDoubleSpinBox, QDateEdit {
    background: white; border: 1px solid #dcdde1; border-radius: 4px; padding: 4px 8px; }
QLineEdit:focus, QComboBox:focus { border-color: #3498db; }
QTableView { background: white; border: 1px solid #dcdde1; gridline-color: #ecf0f1; }
QHeaderView::section { background: #ecf0f1; padding: 6px; border: none; border-right: 1px solid #dcdde1; }
QTableView::item:selected { background: #d6eaf8; color: #2c3e50; }
QTabBar::tab, QLabel { color: #2c3e50; }
QMessageBox QLabel { color: #2c3e50; }
